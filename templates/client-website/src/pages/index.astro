---
import "../styles/global.css";

const cleanText = (value: unknown, fallback: string, limit = 180) => {
  const candidate = String(value || "").replace(/\s+/g, " ").trim().slice(0, limit);
  return candidate || fallback;
};
const cleanColor = (value: unknown, fallback: string) => {
  const candidate = String(value || "").trim();
  return /^#[0-9a-f]{6}$/i.test(candidate) ? candidate : fallback;
};
const cleanFont = (value: unknown, fallback: string) => {
  const candidate = cleanText(value, "", 80);
  return /^[A-Za-z0-9][A-Za-z0-9 ._-]{0,79}$/.test(candidate) ? candidate : fallback;
};
const cleanUrl = (value: unknown) => {
  try {
    const url = new URL(String(value || ""));
    return url.protocol === "https:" ? url.toString() : "";
  } catch {
    return "";
  }
};

const siteName = cleanText(import.meta.env.PUBLIC_N3XRA_SITE_NAME, "Your new website");
const logoUrl = cleanUrl(import.meta.env.PUBLIC_N3XRA_LOGO_URL);
const primaryColor = cleanColor(import.meta.env.PUBLIC_N3XRA_PRIMARY_COLOR, "#17231b");
const accentColor = cleanColor(import.meta.env.PUBLIC_N3XRA_ACCENT_COLOR, "#b77946");
const headingFont = cleanFont(import.meta.env.PUBLIC_N3XRA_HEADING_FONT, "Fraunces");
const bodyFont = cleanFont(import.meta.env.PUBLIC_N3XRA_BODY_FONT, "Manrope");
const portalUrl = cleanUrl(import.meta.env.PUBLIC_N3XRA_PORTAL_URL);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={`A private website preview for ${siteName}, prepared by N3XRA.`} />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    <title>{siteName} | Website preview</title>
  </head>
  <body style={`--brand-primary:${primaryColor};--brand-accent:${accentColor};--heading-font:${headingFont};--body-font:${bodyFont}`}>
    <main>
      <section class="placeholder" aria-labelledby="page-title">
        <div class="brand">
          {logoUrl && <img src={logoUrl} alt={`${siteName} logo`} />}
          <p class="business-name">{siteName}</p>
        </div>
        <p class="eyebrow">Private preview</p>
        <h1 id="page-title">Website coming soon.</h1>
        {portalUrl && <a class="portal-link" href={portalUrl}>Open client portal <span aria-hidden="true">→</span></a>}
      </section>
    </main>
    <footer><a href="https://n3xra.com/">Built by N3XRA</a></footer>
  </body>
</html>
