{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/library/:slug",
      "destination": "/app/embed.html?slug=:slug"
    },
    {
      "source": "/demo",
      "destination": "/demo/index.html"
    },
    {
      "source": "/demo/files",
      "destination": "/demo/files.html"
    }
  ]
}
