{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/software",
      "destination": "/records",
      "permanent": true
    },
    {
      "source": "/software/:path*",
      "destination": "/records/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/app/library",
      "destination": "/app/dashboard"
    },
    {
      "source": "/app/account",
      "destination": "/app/dashboard"
    },
    {
      "source": "/app/meeting-notes",
      "destination": "/app/recordings"
    },
    {
      "source": "/app/all-meeting-notes",
      "destination": "/app/all-recordings"
    },
    {
      "source": "/library/:slug",
      "destination": "/app/embed?slug=:slug"
    },
    {
      "source": "/utilities/portal/:slug",
      "destination": "/utilities/portal/index.html?slug=:slug"
    },
    {
      "source": "/demo",
      "destination": "/demo/index.html"
    },
    {
      "source": "/demo/files",
      "destination": "/demo/files.html"
    }
  ]
}
