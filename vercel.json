{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/software",
      "destination": "/records",
      "permanent": true
    },
    {
      "source": "/software/:path*",
      "destination": "/records/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/library/:slug",
      "destination": "/app/embed?slug=:slug"
    },
    {
      "source": "/demo",
      "destination": "/demo/index.html"
    },
    {
      "source": "/demo/files",
      "destination": "/demo/files.html"
    }
  ]
}
