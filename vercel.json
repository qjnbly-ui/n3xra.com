{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/software",
      "destination": "/records",
      "permanent": true
    },
    {
      "source": "/software/:path*",
      "destination": "/records/:path*",
      "permanent": true
    },
    {
      "source": "/n3xraadmin/records",
      "destination": "/n3xra-admin/records",
      "permanent": true
    },
    {
      "source": "/n3xraadmin/utilities",
      "destination": "/n3xra-admin/utilities",
      "permanent": true
    },
    {
      "source": "/app",
      "destination": "/n3xra-records",
      "permanent": true
    },
    {
      "source": "/app/index.html",
      "destination": "/n3xra-records",
      "permanent": true
    },
    {
      "source": "/app/config.js",
      "destination": "/shared/config.js",
      "permanent": true
    },
    {
      "source": "/app/lib/supabase-client.js",
      "destination": "/shared/lib/supabase-client.js",
      "permanent": true
    },
    {
      "source": "/app/lib/orgs.js",
      "destination": "/shared/lib/orgs.js",
      "permanent": true
    },
    {
      "source": "/app/dashboard",
      "destination": "/n3xra-records/library",
      "permanent": true
    },
    {
      "source": "/app/dashboard.html",
      "destination": "/n3xra-records/library",
      "permanent": true
    },
    {
      "source": "/app/library",
      "destination": "/n3xra-records/library",
      "permanent": true
    },
    {
      "source": "/app/account",
      "destination": "/n3xra-records/account",
      "permanent": true
    },
    {
      "source": "/app/admin",
      "destination": "/n3xra-admin/records",
      "permanent": true
    },
    {
      "source": "/app/admin.html",
      "destination": "/n3xra-admin/records",
      "permanent": true
    },
    {
      "source": "/app/login",
      "destination": "/n3xra-records/login",
      "permanent": true
    },
    {
      "source": "/app/login.html",
      "destination": "/n3xra-records/login",
      "permanent": true
