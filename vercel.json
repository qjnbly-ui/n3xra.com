    {
      "source": "/app/meeting-notes",
      "destination": "/n3xra-records/meeting-notes",
      "permanent": true
    },
    {
      "source": "/app/all-recordings",
      "destination": "/n3xra-records/all-meeting-notes",
      "permanent": true
    },
    {
      "source": "/app/all-recordings.html",
      "destination": "/n3xra-records/all-meeting-notes",
      "permanent": true
    },
    {
      "source": "/app/all-meeting-notes",
      "destination": "/n3xra-records/all-meeting-notes",
      "permanent": true
    },
    {
      "source": "/app/embed",
      "destination": "/n3xra-records/embed",
      "permanent": true
    },
    {
      "source": "/app/embed.html",
      "destination": "/n3xra-records/embed",
      "permanent": true
    },
    {
      "source": "/app/shared-document",
      "destination": "/n3xra-records/shared-document",
