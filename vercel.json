{
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "(?<portalTenant>[^.]+)\\.portal\\.n3xra\\.com"
        }
      ],
      "destination": "/client-portal/login",
      "permanent": false
    },
    {
      "source": "/admin/applications",
      "destination": "/account/admin/applications",
      "permanent": true
    },
    {
      "source": "/n3xra-admin/records",
      "destination": "/n3xra-admin/records/organizations",
      "permanent": true
    },
    {
      "source": "/n3xra-virals/web",
      "destination": "/virals",
      "permanent": true
    },
    {
      "source": "/n3xra-records/login/",
      "destination": "/n3xra-records/login",
      "permanent": true
    },
    {
      "source": "/software",
      "destination": "/records",
      "permanent": true
    },
    {
      "source": "/software/:path*",
      "destination": "/records/:path*",
      "permanent": true
    },
    {
      "source": "/n3xraadmin/records",
      "destination": "/n3xra-admin/records",
      "permanent": true
    },
    {
      "source": "/n3xraadmin/utilities",
      "destination": "/n3xra-admin/utilities",
      "permanent": true
    },
    {
      "source": "/app",
      "destination": "/n3xra-records",
      "permanent": true
    },
    {
      "source": "/app/index.html",
      "destination": "/n3xra-records",
      "permanent": true
    },
    {
      "source": "/app/config.js",
      "destination": "/shared/config.js",
      "permanent": true
    },
    {
      "source": "/app/lib/supabase-client.js",
      "destination": "/shared/lib/supabase-client.js",
      "permanent": true
    },
    {
      "source": "/app/lib/orgs.js",
      "destination": "/shared/lib/orgs.js",
      "permanent": true
    },
    {
      "source": "/app/dashboard",
      "destination": "/n3xra-records/library",
      "permanent": true
    },
    {
      "source": "/app/dashboard.html",
      "destination": "/n3xra-records/library",
      "permanent": true
    },
    {
      "source": "/app/library",
      "destination": "/n3xra-records/library",
      "permanent": true
    },
    {
      "source": "/app/account",
      "destination": "/n3xra-records/account",
      "permanent": true
    },
    {
      "source": "/app/admin",
      "destination": "/n3xra-admin/records",
      "permanent": true
    },
    {
      "source": "/app/admin.html",
      "destination": "/n3xra-admin/records",
      "permanent": true
    },
    {
      "source": "/app/login",
      "destination": "/n3xra-records/login",
      "permanent": true
    },
    {
      "source": "/app/login.html",
      "destination": "/n3xra-records/login",
      "permanent": true
    },
    {
      "source": "/app/reset-password",
      "destination": "/n3xra-records/reset-password",
      "permanent": true
    },
    {
      "source": "/app/reset-password.html",
      "destination": "/n3xra-records/reset-password",
      "permanent": true
    },
    {
      "source": "/app/files",
      "destination": "/n3xra-records/library",
      "permanent": true
    },
    {
      "source": "/app/files.html",
      "destination": "/n3xra-records/library",
      "permanent": true
    },
    {
      "source": "/app/documents",
      "destination": "/n3xra-records/documents",
      "permanent": true
    },
    {
      "source": "/app/documents.html",
      "destination": "/n3xra-records/documents",
      "permanent": true
    },
    {
      "source": "/app/messages",
      "destination": "/n3xra-records/messages",
      "permanent": true
    },
    {
      "source": "/app/messages.html",
      "destination": "/n3xra-records/messages",
      "permanent": true
    },
    {
      "source": "/app/recordings",
      "destination": "/n3xra-records/meeting-notes",
      "permanent": true
    },
    {
      "source": "/app/recordings.html",
      "destination": "/n3xra-records/meeting-notes",
      "permanent": true
    },
    {
      "source": "/app/meeting-notes",
      "destination": "/n3xra-records/meeting-notes",
      "permanent": true
    },
    {
      "source": "/app/all-recordings",
      "destination": "/n3xra-records/all-meeting-notes",
      "permanent": true
    },
    {
      "source": "/app/all-recordings.html",
      "destination": "/n3xra-records/all-meeting-notes",
      "permanent": true
    },
    {
      "source": "/app/all-meeting-notes",
      "destination": "/n3xra-records/all-meeting-notes",
      "permanent": true
    },
    {
      "source": "/app/embed",
      "destination": "/n3xra-records/embed",
      "permanent": true
    },
    {
      "source": "/app/embed.html",
      "destination": "/n3xra-records/embed",
      "permanent": true
    },
    {
      "source": "/app/shared-document",
      "destination": "/n3xra-records/shared-document",
      "permanent": true
    },
    {
      "source": "/app/shared-document.html",
      "destination": "/n3xra-records/shared-document",
      "permanent": true
    },
    {
      "source": "/n3xra-records/files",
      "destination": "/n3xra-records/library",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/p/:slug",
      "destination": "/project-card?slug=:slug"
    },
    {
      "source": "/card/:slug",
      "destination": "/card?slug=:slug"
    },
    {
      "source": "/website-preview/:run/:token",
      "destination": "/api/website-change-live-preview?run=:run&token=:token&path=index.html"
    },
    {
      "source": "/website-preview/:run/:token/:path*",
      "destination": "/api/website-change-live-preview?run=:run&token=:token&path=:path*"
    },
    {
      "source": "/n3xra-records",
      "destination": "/n3xra-records/index.html"
    },
    {
      "source": "/n3xra-records/login",
      "destination": "/n3xra-records/login.html"
    },
    {
      "source": "/n3xra-records/library",
      "destination": "/n3xra-records/files.html"
    },
    {
      "source": "/n3xra-records/account",
      "destination": "/n3xra-records/account/index.html"
    },
    {
      "source": "/n3xra-admin/utilities",
      "destination": "/n3xra-admin/utilities/index.html"
    },
    {
      "source": "/n3xra-records/meeting-notes",
      "destination": "/n3xra-records/recordings.html"
    },
    {
      "source": "/n3xra-records/all-meeting-notes",
      "destination": "/n3xra-records/all-recordings.html"
    },
    {
      "source": "/n3xra-records/record-transfer",
      "destination": "/n3xra-records/record-transfer.html"
    },
    {
      "source": "/library/:slug",
      "destination": "/n3xra-records/embed?slug=:slug"
    },
    {
      "source": "/utilities/portal/:slug",
      "destination": "/utilities/portal/index.html?slug=:slug"
    },
    {
      "source": "/utilities/workspace/onboarding",
      "destination": "/utilities/workspace/onboarding/index.html"
    },
    {
      "source": "/utilities/workspace/settings",
      "destination": "/utilities/workspace/settings/index.html"
    },
    {
      "source": "/utilities/workspace/team",
      "destination": "/utilities/workspace/team/index.html"
    },
    {
      "source": "/utilities/workspace/features",
      "destination": "/utilities/workspace/features/index.html"
    },
    {
      "source": "/demo",
      "destination": "/demo/index.html"
    },
    {
      "source": "/demo/files",
      "destination": "/demo/files.html"
    }
  ],
  "headers": [
    {
      "source": "/n3xra-admin/contact-cards",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/n3xra-admin/contact-cards/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/card/admin.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cleanup-recording-chunks",
      "schedule": "17 4 * * *"
    },
    {
      "path": "/api/sync-client-analytics",
      "schedule": "37 4 * * *"
    }
  ]
}
