{
  "expo": {
    "name": "N3XRA Admin",
    "slug": "n3xra-admin",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "n3xra-admin",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.n3xra.admin",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "N3XRA Admin uses notifications to alert you about important platform activity."
      }
    },
    "android": {
      "package": "com.n3xra.admin",
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "f6b0bbe2-6691-4c95-b8d3-a4cfa7b3b37e"
      }
    },
    "owner": "n3xra"
  }
}
